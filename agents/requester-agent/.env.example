# Claude Agent SDK auth (API-key only — see agent-stack-starter-kits kits/claude-agent-sdk README)
ANTHROPIC_API_KEY=

# Job board this agent posts jobs to / reads quotes from
JOB_BOARD_URL=http://localhost:4000

# Deployed JobEscrow contract address on Arc Testnet (see contracts/README.md)
JOB_ESCROW_ADDRESS=

# This agent's Circle Agent Wallet address (from `circle wallet list --type agent`)
REQUESTER_WALLET_ADDRESS=

# Max USDC this agent will commit to a single job
BUDGET_CAP_USDC=5
