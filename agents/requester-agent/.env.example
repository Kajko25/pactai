# Claude Agent SDK auth (API-key only — see agent-stack-starter-kits kits/claude-agent-sdk README)
ANTHROPIC_API_KEY=

# Job board this agent posts jobs to / reads quotes from
JOB_BOARD_URL=http://localhost:4000

# Slot source (the oracle) deliveries are verified against
SLOT_SOURCE_URL=http://localhost:4100

# Chain connection — local anvil (31337) or Arc Testnet (5042002)
RPC_URL=http://localhost:8545
CHAIN_ID=31337

# Deployed JobEscrow + USDC addresses on the target chain
# Arc Testnet USDC (native ERC-20 view): 0x3600000000000000000000000000000000000000
JOB_ESCROW_ADDRESS=
USDC_ADDRESS=

# Wallet backend:
#   (default) — plain EOA signing with REQUESTER_PRIVATE_KEY below
#   circle    — spend from a Circle Agent Wallet via the Circle CLI; no key
#               in the env, the authenticated CLI session is the credential
WALLET_BACKEND=
CIRCLE_CHAIN=ARC-TESTNET
CIRCLE_WALLET_ADDRESS=

# This agent's wallet key (NEVER commit a real key; local anvil keys only in dev)
REQUESTER_PRIVATE_KEY=

# Max USDC this agent will commit to a single job
BUDGET_CAP_USDC=5
