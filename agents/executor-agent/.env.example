# Claude Agent SDK auth (API-key only)
ANTHROPIC_API_KEY=

# Job board this agent polls for open jobs
JOB_BOARD_URL=http://localhost:4000

# Slot source this hunter polls for appearing slots
SLOT_SOURCE_URL=http://localhost:4100

# Chain connection — local anvil (31337) or Arc Testnet (5042002)
RPC_URL=http://localhost:8545
CHAIN_ID=31337

# Deployed JobEscrow + USDC addresses on the target chain
JOB_ESCROW_ADDRESS=
USDC_ADDRESS=

# This agent's wallet key (NEVER commit a real key; local anvil keys only in dev)
EXECUTOR_PRIVATE_KEY=

# Fixed price this hunter quotes for a slot-hunt job (MVP: no dynamic pricing)
QUOTE_PRICE_USDC=1
