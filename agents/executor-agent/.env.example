# Claude Agent SDK auth (API-key only)
ANTHROPIC_API_KEY=

# Job board this agent polls for open jobs
JOB_BOARD_URL=http://localhost:4000

# Deployed JobEscrow contract address on Arc Testnet
JOB_ESCROW_ADDRESS=

# This agent's Circle Agent Wallet address
EXECUTOR_WALLET_ADDRESS=

# Fixed price this agent quotes for the one task type it supports in the MVP
# (narrow scope on purpose — see docs/PLAN.md cut list)
QUOTE_PRICE_USDC=1
